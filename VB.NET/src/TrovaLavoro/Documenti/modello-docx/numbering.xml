<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- L'elenco puntato delle competenze. È un elenco vero e non un « • » scritto a mano
     nel testo: così il pallino resta fuori dal contenuto, e chi estrae il testo dal
     file — un lettore automatico, o il collaudo che rilegge quel che ha scritto —
     ritrova la competenza pulita. Entra nello ZIP come «word/numbering.xml». -->
<w:numbering xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
  <w:abstractNum w:abstractNumId="0">
    <w:multiLevelType w:val="hybridMultilevel"/>
    <w:lvl w:ilvl="0">
      <w:start w:val="1"/>
      <w:numFmt w:val="bullet"/>
      <!-- Il pallino del font Symbol. -->
      <w:lvlText w:val="&#xF0B7;"/>
      <w:lvlJc w:val="left"/>
      <w:pPr>
        <w:ind w:left="360" w:hanging="360"/>
      </w:pPr>
      <w:rPr>
        <w:rFonts w:ascii="Symbol" w:hAnsi="Symbol" w:hint="default"/>
      </w:rPr>
    </w:lvl>
  </w:abstractNum>
  <w:num w:numId="1">
    <w:abstractNumId w:val="0"/>
  </w:num>
</w:numbering>
