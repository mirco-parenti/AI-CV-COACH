<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TrovaLavoro</RootNamespace>
    <AssemblyName>TrovaLavoro</AssemblyName>
    <!-- Avvio da Programma.Main: il DPI SystemAware va impostato prima di ogni finestra. -->
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>TrovaLavoro.Programma</StartupObject>
    <!-- Solo 64 bit (cap. 13.1); il runtime win-x64 lo fissa publish.bat. -->
    <PlatformTarget>x64</PlatformTarget>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <!-- I sorgenti sono UTF-8: senza questo le lettere accentate e il « · » del
         pannello logo verrebbero letti con la codepage di sistema. -->
    <CodePage>65001</CodePage>
    <!-- L'icona dell'eseguibile (cap. 13.5). È l'unico file immagine del prodotto
         nel repository, e non per una deroga di comodo: <ApplicationIcon> vuole un
         file su disco, e un Base64 nel sorgente MSBuild non lo sa leggere. Il vincolo
         vero resta rispettato: il file entra DENTRO l'exe, non accanto. -->
    <ApplicationIcon>Risorse\TrovaLavoro.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Proprietà dell'eseguibile, scheda «Dettagli» di Windows (cap. 13.5). -->
  <PropertyGroup>
    <Product>TrovaLavoro</Product>
    <Company>Aviolab AI</Company>
    <Copyright>© 2026 Aviolab AI</Copyright>
    <AssemblyTitle>Trova annunci, prepara CV e lettera su misura</AssemblyTitle>
    <Description>Trova annunci, prepara CV e lettera su misura</Description>
  </PropertyGroup>

  <!-- La versione non si scrive qui: si legge dalla costante di Versione.vb, che
       resta l'unica fonte (cap. 13.5). Da lì derivano versione di file, di assembly
       e informativa dell'eseguibile. -->
  <PropertyGroup>
    <_SorgenteVersione>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Versione.vb'))</_SorgenteVersione>
    <Version>$([System.Text.RegularExpressions.Regex]::Replace($(_SorgenteVersione), '(?s)^.*?Numero\s+As\s+String\s*=\s*"([0-9]+\.[0-9]+\.[0-9]+)".*$', '$1'))</Version>
    <!-- Senza questo la versione di prodotto mostrata da Windows si porta dietro
         il codice del commit Git. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Il codice del commit che ha prodotto questo eseguibile (cap. 13.9; reperto D-R1 del
       giro D). Non è la versione, ed è il punto: la versione è un'etichetta che si scrive
       a mano, e il 24 agosto 2026 due file diversi hanno portato lo stesso «1.0.000».
       Lo passa publish.bat con -p:CodiceSorgente=...; chi compila per provare non lo
       passa, e allora l'attributo non c'è affatto — una compilazione di sviluppo non
       corrisponde a nessun commit, e dirlo è più onesto che inventarne uno. -->
  <ItemGroup Condition="'$(CodiceSorgente)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CodiceSorgente</_Parameter1>
      <_Parameter2>$(CodiceSorgente)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- L'interfaccia sta tutta in Ui\ (cap. 02.3). In VB le cartelle non toccano i
       namespace: i form e i pannelli restano in TrovaLavoro, come i loro designer. -->
  <ItemGroup>
    <Compile Update="Ui\FormPrincipale.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Ui\FormPrincipale.Designer.vb">
      <DependentUpon>FormPrincipale.vb</DependentUpon>
    </Compile>
    <Compile Update="Ui\FinestraConfermaCritica.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Ui\FinestraConfermaCritica.Designer.vb">
      <DependentUpon>FinestraConfermaCritica.vb</DependentUpon>
    </Compile>
    <Compile Update="Ui\FinestraChiaveApi.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Ui\FinestraChiaveApi.Designer.vb">
      <DependentUpon>FinestraChiaveApi.vb</DependentUpon>
    </Compile>
    <Compile Update="Ui\FinestraInformativa.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Ui\FinestraInformativa.Designer.vb">
      <DependentUpon>FinestraInformativa.vb</DependentUpon>
    </Compile>
    <Compile Update="Ui\FinestraDocumenti.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Ui\FinestraDocumenti.Designer.vb">
      <DependentUpon>FinestraDocumenti.vb</DependentUpon>
    </Compile>
    <Compile Update="Ui\PannelloProfilo.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Ui\PannelloProfilo.Designer.vb">
      <DependentUpon>PannelloProfilo.vb</DependentUpon>
    </Compile>
    <Compile Update="Ui\PannelloDialogo.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Ui\PannelloDialogo.Designer.vb">
      <DependentUpon>PannelloDialogo.vb</DependentUpon>
    </Compile>
    <Compile Update="Ui\PannelloEmail.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Ui\PannelloEmail.Designer.vb">
      <DependentUpon>PannelloEmail.vb</DependentUpon>
    </Compile>
    <Compile Update="Ui\PannelloRicerca.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Ui\PannelloRicerca.Designer.vb">
      <DependentUpon>PannelloRicerca.vb</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- Il pool integrato (cap. 4.2): i prompt entrano nell'eseguibile come risorse,
       così l'app copiata su un PC nudo funziona senza file a fianco. Restano file
       .md veri nel repo, e la stessa cartella serve da pool esterno di prova.

       LogicalName fissa il percorso con cui il caricatore li ritrova: senza, il
       nome della risorsa impasterebbe cartelle ed estensione in un'unica stringa
       di punti, indistinguibile per nomi come «cv_base.it.md».

       WithCulture=false non è facoltativo: la nomenclatura del cap. 4.3 mette la
       lingua nel nome del file, e MSBuild legge quel «.it» come codice di lingua.
       Senza questo, i tre prompt di generazione finiscono in un assembly satellite
       dentro una cartella «it» accanto all'eseguibile — una DLL a fianco, cioè
       esattamente ciò che il cap. 13 vieta, e per giunta in silenzio. -->
  <ItemGroup>
    <EmbeddedResource Include="prompt-pool\**\*.md;prompt-pool\pool_manifest.json"
                      WithCulture="false">
      <LogicalName>pool/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- La tipografia dei documenti generati (cap. 05.4 e 05.5): le parti fisse di un
       .docx — stili, margini, elenchi puntati — e il modello HTML da cui nasce il PDF
       entrano nell'eseguibile come risorse, allo stesso modo del pool. Restano file
       veri nel repo, così cambiare font o margini non chiede di toccare il codice
       delle stampanti. -->
  <ItemGroup>
    <EmbeddedResource Include="Documenti\modello-docx\*.xml" WithCulture="false">
      <LogicalName>modello-docx/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Documenti\modello-html\*.html;Documenti\modello-html\*.css"
                      WithCulture="false">
      <LogicalName>modello-html/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Il marchio dentro l'eseguibile (cap. 13.5): la stessa icona che veste l'exe veste
       anche le finestre, e la schermata di avvio copre i primi istanti (cap. 03.4). Come
       il pool e i modelli, entrano come risorse incorporate: accanto all'exe non resta
       nessun file.

       WithCulture=false per la ragione dei prompt: senza, un punto nel nome verrebbe
       letto come codice di lingua e ne nascerebbe un assembly satellite. -->
  <ItemGroup>
    <EmbeddedResource Include="Risorse\TrovaLavoro.ico;Risorse\schermata-avvio.png;Risorse\sfondo-menu.png"
                      WithCulture="false">
      <LogicalName>marchio/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Il browser integrato (cap. 06, cap. 13.3). Entra a T4 e non a T5, perché la
       stampa PDF del cap. 05.5 passa da qui: la versione è quella provata al cancello
       di T4, il cui numero di build combacia col runtime Evergreen di Windows. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

</Project>
