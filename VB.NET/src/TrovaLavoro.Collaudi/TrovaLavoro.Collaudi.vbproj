<Project Sdk="Microsoft.NET.Sdk">

  <!-- Banco di collaudo di TrovaLavoro. Non fa parte del rilascio: non viene mai
       pubblicato nell'eseguibile (cap. 13). Ci girano la batteria di tutti i giorni,
       le non-regressioni contro il prototipo HTML+JS e i collaudi di tappa con l'API
       vera (cap. 14). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TrovaLavoro.Collaudi</RootNamespace>
    <AssemblyName>TrovaLavoro.Collaudi</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <!-- I casi di collaudo contengono testo italiano accentato preso dal prototipo:
         senza questo verrebbe letto con la codepage di sistema. -->
    <CodePage>65001</CodePage>
    <IsPackable>false</IsPackable>
    <!-- Tiene fuori dalla batteria normale i collaudi che vogliono l'API vera e il
         prototipo acceso; il file dice come lanciarli. -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\collaudi.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <!-- La copertura misurata (2026-08-27, dalla revisione del giro D). Non cambia
         niente di come gira la batteria: entra solo quando si chiede
         a «dotnet test» l'opzione «collect» con «XPlat Code Coverage», e allora scrive un
         coverage.cobertura.xml sotto TestResults. Serve a rispondere a una domanda che
         1169 collaudi verdi non rispondono da soli: *quanto* del prodotto toccano. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrovaLavoro\TrovaLavoro.vbproj" />
  </ItemGroup>

</Project>
